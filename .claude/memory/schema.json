{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://product-strategist.local/schema/project-memory.json",
  "title": "Project Memory Store",
  "description": "Shared memory for the AI Product Discovery Platform.",
  "type": "object",
  "required": ["version", "records"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/definitions/record" }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "title": "Memory Record",
      "required": [
        "id", "type", "title", "summary", "status", "confidence",
        "created_at", "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "insight", "decision", "assumption", "persona", "competitor",
            "market-signal", "opportunity", "risk", "feature-idea",
            "research-source", "requirement", "system-impact"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One to a few sentences. For structured types (decision, persona, competitor), this is a human-scannable headline — the substance lives in `data`, not here."
        },
        "details": {
          "type": "string",
          "description": "Optional free-form narrative/elaboration. Never the only place a downstream skill has to look for a required field — required fields belong in `data`."
        },
        "data": {
          "type": "object",
          "description": "Type-specific structured payload. Shape is required to match `type` — see the conditional rules below. Kept generic here so new types can be added without touching this schema, but decision, assumption, research-source, and competitor have concrete required shapes as the ones already in active use."
        },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "validated", "invalidated", "deprecated"]
        },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "reference": { "type": "string" }
            }
          },
          "default": []
        },
        "related_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "owner": { "type": "string" },
        "session_id": { "type": "string" },
        "project_id": {
          "type": "string",
          "description": "Unused for now: memory stores are one-per-project (see memory/README.md), so the store's file path already identifies the project and this field has no reason to be set. Kept in the schema only in case a future need for a single multi-project store arises — do not populate it until that's a real, adopted change."
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["alternatives_considered", "recommendation", "rationale"],
                "properties": {
                  "alternatives_considered": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["option"],
                      "properties": {
                        "option": { "type": "string" },
                        "pros": { "type": "array", "items": { "type": "string" } },
                        "cons": { "type": "array", "items": { "type": "string" } },
                        "rejected_because": { "type": "string" },
                        "impact": {
                          "type": "object",
                          "description": "Optional. Structured impact assessment for this option — used by strategy-agent; discovery-interview's decisions don't need this and shouldn't be retrofitted to include it.",
                          "properties": {
                            "customer_impact": { "type": "string" },
                            "business_impact": { "type": "string" },
                            "engineering_complexity": { "type": "string", "enum": ["low", "medium", "high"] },
                            "operational_complexity": { "type": "string", "enum": ["low", "medium", "high"] },
                            "scalability_risk": { "type": "string" },
                            "long_term_maintainability": { "type": "string" }
                          }
                        }
                      }
                    }
                  },
                  "recommendation": { "type": "string", "minLength": 1 },
                  "rationale": { "type": "string", "minLength": 1 },
                  "open_questions": { "type": "array", "items": { "type": "string" }, "default": [] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "assumption" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["statement", "validation_status"],
                "properties": {
                  "statement": {
                    "type": "string",
                    "description": "The assumption itself, stated as a falsifiable claim, e.g. 'Support teams handle <5 tickets/week for this flow today.'"
                  },
                  "validation_status": {
                    "type": "string",
                    "enum": ["unvalidated", "validating", "validated", "invalidated"]
                  },
                  "impact_if_wrong": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "research-source" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["claim", "retrieved_at"],
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The specific, falsifiable finding this source supports — not a paraphrase of the whole source, e.g. 'Competitor X's free tier caps team invites at 3 seats,' not 'Competitor X has a free tier.'"
                  },
                  "retrieved_at": {
                    "type": "string",
                    "format": "date",
                    "description": "ISO 8601 date this claim was retrieved/verified, so it can be checked for staleness later."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "competitor" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["product_name", "positioning", "evidence_ids"],
                "properties": {
                  "product_name": { "type": "string", "minLength": 1 },
                  "positioning": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One sentence, in the competitor's own framing — how they describe themselves — not your interpretation of them."
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" },
                    "description": "research-source record ids backing this profile. A competitor record with no evidence behind it should not exist."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "requirement" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["statement", "acceptance_criteria", "elaborates_decision_id"],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A single concrete, testable functional requirement — not a restatement of the decision itself."
                  },
                  "acceptance_criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" },
                    "description": "Specific, checkable pass/fail conditions."
                  },
                  "edge_cases": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": []
                  },
                  "elaborates_decision_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The id of the decision record this requirement makes buildable. Required so every requirement traces to a specific, already-made choice."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "system-impact" } } },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["system_area", "impact_description", "severity", "elaborates_requirement_ids"],
                "properties": {
                  "system_area": {
                    "type": "string",
                    "enum": [
                      "apis", "data-model", "events", "analytics", "reporting",
                      "dashboards", "customer-support", "operations",
                      "customer-communication", "monitoring", "observability"
                    ]
                  },
                  "impact_description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A specific, concrete downstream effect — not a restatement of the requirement itself."
                  },
                  "severity": { "type": "string", "enum": ["low", "medium", "high"] },
                  "elaborates_requirement_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" },
                    "description": "requirement record ids this impact traces from. A system-impact record with no traceable requirement is a guess, not an assessment."
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
